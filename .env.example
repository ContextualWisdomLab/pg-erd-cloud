# App metadata PostgreSQL (for this ERD SaaS itself)
POSTGRES_DB=erd
POSTGRES_USER=erd
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_PORT=54321

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Production edge port used by compose.prod.yaml (Traefik).
TRAEFIK_HTTP_PORT=8080
# Required by compose.prod.yaml: the minimal direct-peer /32 or /128 CIDR(s)
# Traefik observes for the host-local TLS terminator. With Docker NAT this is
# commonly the bridge gateway, not the terminator process's original address.
# Inspect the deployment-specific peer before starting production-style Compose.
TRAEFIK_TRUSTED_PROXY_CIDRS=

# Backend app secret (used for encrypting stored connection DSNs)
APP_SECRET=change-me-long-random

# Required for target introspection. Empty fails closed and rejects all targets.
# Use comma-separated exact hostnames/IPs or narrow wildcard domains such as
# *.db.example.com; never use a broad production wildcard.
DB_INTROSPECTION_ALLOWED_HOSTS=

# Frontend -> backend
VITE_API_BASE_URL=http://localhost:8000

# Backend CORS
CORS_ORIGINS=http://localhost:5173

# Backend API rate limiting (applies to /api/*)
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
# Set true only behind a trusted proxy/ingress that sanitizes X-Forwarded-For.
# HOPS counts from the right side of that header. The local/development default
# is one; compose.prod.yaml overrides it to two for client -> TLS terminator ->
# Traefik -> backend.
API_RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
API_RATE_LIMIT_TRUSTED_PROXY_HOPS=1
API_RATE_LIMIT_MAX_KEYS=10000
# Tighter unauthenticated throttle for public share-link reads/exports.
SHARE_LINK_TTL_HOURS=168
SHARE_LINK_RATE_LIMIT_ENABLED=true
SHARE_LINK_RATE_LIMIT_REQUESTS=30
SHARE_LINK_RATE_LIMIT_WINDOW_SECONDS=60
SHARE_LINK_RATE_LIMIT_MAX_KEYS=10000

# Optional: OIDC (Casdoor) issuer; if set backend verifies JWTs
# OIDC_ISSUER=http://localhost:8002
# OIDC_AUDIENCE=erd-local

# Optional: allowed JWT signing algorithms (comma-separated).
# Default is RS256.
# OIDC_ALGORITHMS=RS256
