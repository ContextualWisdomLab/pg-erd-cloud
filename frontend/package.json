{
  "name": "pg-erd-cloud-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tooling.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "npm run typecheck",
    "e2e": "echo 'No e2e framework configured'"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.9",
    "fast-check": "^4.8.0",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.10",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.18"
  }
}
