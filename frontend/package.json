    "@types/testing-library__jest-dom": "5.14.9",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.1",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
